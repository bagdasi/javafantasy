						{
							//qpgstr[i] = qpglist.get(i);
							qpgstr[i] = qpglistc[i].qpgstrSet();
						}
						qpgFileSave(selectedFile,qpgstr);
					}
				}catch(NullPointerException ioe2)
				{
					System.out.println("NummPoint예외처리상황이 발생했습니다.");
