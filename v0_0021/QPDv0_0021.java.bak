				inc++;
            }
        }

        // 4x4 영역 추출 (예: (3, 3)부터 (6, 6)까지)
        int startRow = 0;
        int startCol = 0;
        
		int[][] subGrid = new int[setheight][setwidth];
        
		for (int i = 0; i < setheight; i++) {
            for (int j = 0; j < setwidth; j++) {
                
				if(i<preheight && j<prewidth)
