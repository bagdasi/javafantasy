		System.out.println();*/
		int[][] original = new int[preheight][prewidth]; // 기존 5×5 행렬
        int[][] transformed = new int[setheight][setwidth]; // 변환할 7×4 행렬
		int countx = 0,county = 0,setcount = 0;;
        for (int i = 0; i < preheight; i++) {
            for (int j = 0; j < prewidth; j++) {
                original[i][j] = setcount++;
            }
        }
		for (int i = 0; i < setheight; i++) {
            for (int j = 0; j < setwidth; j++) {
                transformed[i][j] = -1;
            }
        }
		for (int i = 0; i < setheight; i++) {
            for (int j = 0; j < setwidth; j++) {
                if(county<preheight&&countx<prewidth)
				{
				transformed[i][j] = original[county][countx];
				}
				countx++;
				if(countx==setwidth){county++; countx =0; break;}
				if((j+1)==setwidth){county++; countx =0;}
            }
        }
		for (int i = 0; i < setheight; i++) {
            for (int j = 0; j < setwidth; j++) {
                System.out.print(transformed[i][j]+ " ");;
            }
			System.out.println();
        }
		int[] returntmp = new int[setheight*setwidth];
		int count = 0;
		for (int i = 0; i < setheight; i++) {
            for (int j = 0; j < setwidth; j++) {
                returntmp[count] = transformed[i][j];
				count++;
            }
        }

		return returntmp;
	}
