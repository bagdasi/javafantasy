				}


				@Override
				public void keyReleased(KeyEvent e) {
					if(lastbool)
					{
						
					}else
					{
						
						int lastIndex = mainClassField2.getText().lastIndexOf('.');
						
						
						String input="",directory="",tmp="";
						
