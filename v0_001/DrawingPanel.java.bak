	public BufferedImage DPanel()
	{
		
		image = new BufferedImage(qpp.dpwidth,qpp.dpheight,BufferedImage.TYPE_INT_ARGB);
		Graphics g = image.getGraphics();
		g.setColor(Color.WHITE);
		g.fillRect(0,0,qpp.dpwidth, qpp.dpheight);
		g.dispose();
		this.repaint();
		
		return image;
		
		
	}
